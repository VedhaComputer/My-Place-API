# Server
NODE_ENV=development
PORT=4001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/india_place_api

# Authentication (Dual-Gate: User JWT & Approved Application Verification)
JWT_ACCESS_SECRET=replace_with_secure_random_secret_min_32_chars_for_india_places
APP_GATE_SECRET=replace_with_secure_random_secret_min_32_chars_for_apps
APP_CACHE_TTL_MS=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
